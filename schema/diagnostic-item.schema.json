{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpeakStep CEFR internal diagnostic item bank",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["itemID", "schemaVersion", "cefrLevel", "skill", "subskill", "mode", "prompt", "explanation", "difficulty", "estimatedSeconds", "tags", "source", "version", "status", "evaluationScope"],
    "properties": {
      "itemID": { "$ref": "#/$defs/text" }, "schemaVersion": { "const": 1 },
      "cefrLevel": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
      "skill": { "enum": ["vocabulary", "grammar", "reading", "listening", "speakingContent", "fluency", "pronunciation", "interaction", "practicalCommunication", "reviewRetention"] },
      "subskill": { "$ref": "#/$defs/text" }, "mode": { "enum": ["objective", "speaking"] },
      "prompt": { "$ref": "#/$defs/text" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
      "correctAnswer": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" },
      "difficulty": { "type": "number", "minimum": 1, "maximum": 6 },
      "estimatedSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
      "tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
      "source": { "$ref": "#/$defs/text" }, "version": { "type": "integer", "minimum": 1 },
      "status": { "enum": ["active", "retired", "draft"] }, "audioText": { "$ref": "#/$defs/text" },
      "speakingPrompt": { "$ref": "#/$defs/text" }, "preparationSeconds": { "type": "integer", "minimum": 0 },
      "maximumSeconds": { "type": "integer", "minimum": 1 }, "targetFunctions": { "$ref": "#/$defs/textArray" },
      "targetVocabulary": { "$ref": "#/$defs/textArray" }, "evaluationScope": { "$ref": "#/$defs/text" },
      "referenceAnswer": { "$ref": "#/$defs/text" }, "referenceAudioURL": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "textArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
  }
}
