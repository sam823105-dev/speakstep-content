{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sam823105-dev/speakstep-content/schema/daily-lesson.schema.json",
  "title": "SpeakStep daily B2 lesson feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "updatedAt", "lessons"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lessons": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/lesson" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "textArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "lesson": {
      "type": "object", "additionalProperties": false,
      "required": ["lessonID", "publishDate", "title", "theme", "level", "coreMinutes", "extensionMinutes", "objectives", "warmUpQuestions", "passage", "passageTranslation", "vocabulary", "quiz", "speakingPrompts", "dialogue", "writingTask", "extensionTask"],
      "properties": {
        "lessonID": { "$ref": "#/$defs/text" }, "publishDate": { "type": "string", "format": "date" },
        "title": { "$ref": "#/$defs/text" }, "theme": { "$ref": "#/$defs/text" }, "level": { "enum": ["B2"] },
        "coreMinutes": { "type": "integer", "minimum": 30, "maximum": 45 },
        "extensionMinutes": { "type": "integer", "minimum": 0, "maximum": 30 },
        "objectives": { "$ref": "#/$defs/textArray" }, "warmUpQuestions": { "$ref": "#/$defs/textArray" },
        "passage": { "$ref": "#/$defs/text" }, "passageTranslation": { "$ref": "#/$defs/text" },
        "audioURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "resourceURLs": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "vocabulary": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/vocabulary" } },
        "quiz": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/question" } },
        "speakingPrompts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/speaking" } },
        "dialogue": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/dialogue" } },
        "writingTask": { "$ref": "#/$defs/text" }, "extensionTask": { "$ref": "#/$defs/text" }
      }
    },
    "vocabulary": { "type": "object", "additionalProperties": false, "required": ["id", "term", "definition", "example"], "properties": { "id": { "$ref": "#/$defs/text" }, "term": { "$ref": "#/$defs/text" }, "definition": { "$ref": "#/$defs/text" }, "example": { "$ref": "#/$defs/text" } } },
    "question": { "type": "object", "additionalProperties": false, "required": ["id", "question", "options", "correctIndex", "explanation"], "properties": { "id": { "$ref": "#/$defs/text" }, "question": { "$ref": "#/$defs/text" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } }, "correctIndex": { "type": "integer", "minimum": 0 }, "explanation": { "$ref": "#/$defs/text" } } },
    "speaking": { "type": "object", "additionalProperties": false, "required": ["id", "prompt", "chineseHint"], "properties": { "id": { "$ref": "#/$defs/text" }, "prompt": { "$ref": "#/$defs/text" }, "chineseHint": { "$ref": "#/$defs/text" } } },
    "dialogue": { "type": "object", "additionalProperties": false, "required": ["id", "partnerLine", "partnerTranslation", "responseGoal", "usefulPhrases"], "properties": { "id": { "$ref": "#/$defs/text" }, "partnerLine": { "$ref": "#/$defs/text" }, "partnerTranslation": { "$ref": "#/$defs/text" }, "responseGoal": { "$ref": "#/$defs/text" }, "usefulPhrases": { "$ref": "#/$defs/textArray" } } }
  }
}
